PORT=4000
# Turso cloud (get from https://turso.tech → create DB → get URL + token)
TURSO_DATABASE_URL=libsql://your-db-username.turso.io
TURSO_AUTH_TOKEN=eyJ...

# JWT secret for login — change in production!
JWT_SECRET=dev-artify-secret-change-me-please-use-random-64chars

# Leave both empty to use local SQLite file: data/artify.db (works offline)
